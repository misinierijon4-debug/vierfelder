# supabase-projekt für zweikampf (das projekt heißt im dashboard weiter vierfelder).
# kopieren nach .env.local, werte aus dem supabase-dashboard unter project settings > api.
VITE_SUPABASE_URL=https://DEINE-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Niemals service_role- oder sb_secret_-Schluessel in VITE_* eintragen: Vite
# liefert diese Variablen an jeden Browser aus. Serversecrets gehoeren
# ausschliesslich in die jeweilige Supabase-Function-/Vault-Konfiguration.

# der öffentliche vapid-schlüssel des projekts steht schon in src/lib/push.ts.
# diese variable braucht nur, wer ein eigenes schlüsselpaar benutzt — dann geht
# sie vor. erzeugt mit `node scripts/vapid.mjs`, anleitung in
# BENACHRICHTIGUNGEN.md.
# VITE_VAPID_PUBLIC_KEY=
