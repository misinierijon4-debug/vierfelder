# supabase-projekt für zweikampf (das projekt heißt im dashboard weiter vierfelder).
# kopieren nach .env.local, werte aus dem supabase-dashboard unter project settings > api.
VITE_SUPABASE_URL=https://DEINE-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# öffentlicher vapid-schlüssel für benachrichtigungen, erzeugt mit
# `node scripts/vapid.mjs`. nur der öffentliche teil, der private bleibt
# geheimnis der edge function. fehlt er, bleibt der schalter unten in der app
# grau. anleitung in BENACHRICHTIGUNGEN.md.
VITE_VAPID_PUBLIC_KEY=
