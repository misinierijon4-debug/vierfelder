{
  "name": "zweikampf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run build:web",
    "build:web": "npm run typecheck && vite build",
    "build:pages": "node scripts/validate-pages-env.mjs && npm run build:web && npm run check:dist",
    "build:sites": "npm run typecheck && vite build --mode sites && npm run check:dist && node scripts/build-sites-worker.mjs && node scripts/check-sites-worker.mjs",
    "check:dist": "node scripts/check-web-build.mjs",
    "check:edge": "deno check --lock=supabase/functions/deno.lock --frozen-lockfile --node-modules-dir=none supabase/functions/fokus/index.ts supabase/functions/schlaf-import/index.ts supabase/functions/push-test/index.ts supabase/functions/gewicht-erinnerung/index.ts supabase/functions/schlaf-erinnerung/index.ts",
    "check:web": "npm test && npm run build:web && npm run check:dist",
    "check:all": "npm run check:web && npm run check:edge",
    "check": "npm run check:all",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.4",
    "motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.11",
    "jsdom": "30.0.1"
  }
}
